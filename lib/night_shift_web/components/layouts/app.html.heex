<%!-- The nav appears only where a tenant is in scope; sign-in pages have none. --%>
<header :if={assigns[:tenant]} class="sticky top-0 z-10 border-b border-zinc-100 bg-white">
  <nav aria-label="Main" class="flex items-center gap-1 overflow-x-auto px-2 py-2">
    <.link
      navigate={~p"/workspace"}
      data-test-id="nav-workspace"
      class="whitespace-nowrap rounded-lg px-3 py-2 text-sm font-semibold text-zinc-700 hover:bg-zinc-100"
    >
      Home
    </.link>
    <.link
      navigate={~p"/chat"}
      data-test-id="nav-chat"
      class="whitespace-nowrap rounded-lg px-3 py-2 text-sm font-semibold text-zinc-700 hover:bg-zinc-100"
    >
      Chat
    </.link>
    <.link
      navigate={~p"/announcements"}
      data-test-id="nav-announcements"
      class="flex items-center gap-2 whitespace-nowrap rounded-lg px-3 py-2 text-sm font-semibold text-zinc-700 hover:bg-zinc-100"
    >
      Announcements <%!-- Absent, not zero: nothing unread should show nothing. --%>
      <span
        :if={(assigns[:unread_announcements] || 0) > 0}
        data-test-id="nav-announcements-unread"
        class="inline-flex min-w-5 items-center justify-center rounded-full bg-zinc-900 px-1.5 py-0.5 text-xs font-semibold text-white"
      >
        {@unread_announcements}
      </span>
    </.link>
  </nav>
</header>

<main class="px-4 py-6 sm:px-6">
  <div class="mx-auto max-w-2xl">
    <.flash_group flash={@flash} />
    {@inner_content}
  </div>
</main>
